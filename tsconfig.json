{
  "compilerOptions": {
    "target": "ES2023", "module": "ES2022", "moduleResolution": "bundler",
    "allowJs": true, "checkJs": true, "noEmit": true, "strict": false, "noImplicitAny": false, "skipLibCheck": true, "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {"three": ["./node_modules/@types/three"], "three/addons/*": ["./node_modules/@types/three/examples/jsm/*"]}
  },
  "include": [
    "shared/loadout.js", "shared/camo.js", "shared/music.js", "shared/sound-layer.js",
    "operator/rig.js", "operator/config.js", "workbench/rails.js", "workbench/stats.js", "assets/js/dither.js",
    "tools/agent/*.mjs", "tools/assets/register-lib.mjs"
  ]
}

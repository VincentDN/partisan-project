{
  "name": "partisan-project",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Partisan Project: an interactive game design document made of playable demos.",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "build": "node tools/build-site.mjs",
    "test": "node --test tests/*.test.mjs tests/legacy/*.test.mjs",
    "check": "node tools/check-site.mjs",
    "assets:operator": "node tools/assets/optimize-operator.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/campaign-bridge.mjs && node tests/e2e/map-travel.mjs && node tests/e2e/campaign-loop.mjs && node tests/e2e/inventory.mjs && node tests/e2e/generated-recon.mjs && node tests/e2e/recon-comparison.mjs && node tests/e2e/recon-teardown.mjs && node tests/e2e/recon-foundation.mjs",
    "test:operator": "node --test tests/generated-recon.test.mjs tests/operator-config.test.mjs tests/rig.test.mjs && node tests/e2e/generated-recon.mjs",
    "contact-sheet": "node tests/e2e/contact-sheet.mjs",
    "test:a11y": "node tests/e2e/a11y.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "test:comparison": "node tests/e2e/recon-comparison.mjs",
    "test:teardown": "node --test tests/recon-audit.test.mjs && node tests/e2e/recon-teardown.mjs",
    "assets:recon-foundation": "node tools/assets/build-recon-foundation.mjs",
    "test:foundation": "node --test tests/recon-foundation.test.mjs && node tests/e2e/recon-foundation.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "^4.1.0",
    "@gltf-transform/extensions": "^4.1.0",
    "@gltf-transform/functions": "^4.1.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.169.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "marked": "^14.1.0",
    "meshoptimizer": "^0.22.0",
    "playwright-core": "^1.48.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "three": "^0.169.0",
    "typescript": "^7.0.2"
  }
}
